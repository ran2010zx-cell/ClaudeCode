# ===========================================
# Notion → Substack + Twitter 自动发布工具配置
# ===========================================
# 复制此文件为 .env 并填入你的实际配置

# ===========================================
# Notion 配置
# ===========================================
# 获取方式: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数据库 ID (从 Notion 页面 URL 获取)
# 格式: https://notion.so/xxxxx?v=yyyyy 中的 xxxxx 部分
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# 翻译配置
# ===========================================
# 选择翻译提供商: openai 或 anthropic
TRANSLATOR_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Anthropic (Claude) 配置
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 语言设置
SOURCE_LANGUAGE=中文
TARGET_LANGUAGE=English

# ===========================================
# Substack 配置
# ===========================================
# Substack 账号邮箱和密码
SUBSTACK_EMAIL=your-email@example.com
SUBSTACK_PASSWORD=your-password

# 你的 Substack 出版物 URL
SUBSTACK_PUBLICATION_URL=https://your-publication.substack.com

# ===========================================
# Twitter/X API 配置
# ===========================================
# 获取方式: https://developer.twitter.com/

# OAuth 1.0a (用于发推)
TWITTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_ACCESS_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bearer Token (只读)
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 推文设置
TWITTER_MAX_TWEET_LENGTH=280
TWITTER_THREAD_DELAY_SECONDS=2

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/translator.log
