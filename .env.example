# Xiaomi News Tracker Configuration
# Copy this file to .env and fill in your values

# ===== Database =====
# SQLite database path (default: sqlite:///data/xiaomi_news.db)
# For PostgreSQL: postgresql://user:password@localhost/dbname
# For MySQL: mysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///data/xiaomi_news.db

# ===== Search Configuration =====
# Comma-separated keywords to search for
SEARCH_KEYWORDS=xiaomi,小米,Xiaomi,XIAOMI,雷军

# Crawl interval in minutes (default: 60)
CRAWL_INTERVAL_MINUTES=60

# Maximum items to fetch per platform per crawl
MAX_ITEMS_PER_PLATFORM=50

# ===== Twitter/X API Credentials =====
# Get these from https://developer.twitter.com/
# Recommended: Use Bearer Token for API v2 (simpler)
TWITTER_BEARER_TOKEN=

# Alternative: OAuth 1.0a credentials
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ===== Weibo API Credentials =====
# Get these from https://open.weibo.com/
# Optional - if not provided, web scraping will be used
WEIBO_APP_KEY=
WEIBO_APP_SECRET=
WEIBO_ACCESS_TOKEN=

# ===== Email Notification =====
# Enable/disable email reports
EMAIL_ENABLED=false

# SMTP configuration (example for Gmail)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Sender email and password (use app password for Gmail)
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Recipient email
EMAIL_TO=recipient@example.com

# ===== Report Configuration =====
# Report format: text, html, or json
REPORT_FORMAT=html

# Minimum number of new items before sending report
REPORT_MIN_ITEMS=1

# ===== Logging =====
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/xiaomi_tracker.log

# ===== Advanced Settings =====
# HTTP request timeout in seconds
REQUEST_TIMEOUT=30

# Delay between requests in seconds (to avoid rate limiting)
REQUEST_DELAY=2.0

# User agent for web scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
